  subgraph PART-UC001-001["User"]
  ADN-UC001-001(("start"))
  ADN-UC001-002["Пользователи должны иметь возможность войти в систему с правами резидента, сотрудника ресепшена, комьюнити-менеджера, управляющего локацией или администратора."]
  ADN-UC001-003["Администратор должен иметь возможность создавать и редактировать локации с названием, адресом, часовым поясом, контактными данными и признаком активности."]
  ADN-UC001-004["Управляющий локацией должен иметь возможность настраивать регулярные часы работы и исключения для отдельных дат."]
  ADN-UC001-005["Управляющий локацией должен иметь возможность создавать и редактировать бронируемые столы и помещения с локацией, названием, типом, вместимостью, оснащением, ценой и признаком активности."]
  ADN-UC001-006["Управляющий локацией должен иметь возможность разместить каждый бронируемый стол и помещение на загруженном плане этажа с сохранением координат."]
  ADN-UC001-007["Резидент должен иметь возможность просматривать доступность столов и помещений в календаре для выбранных локации и диапазона дат."]
  ADN-UC001-008["Резидент должен иметь возможность забронировать один свободный стол на время начала и окончания в пределах часов работы локации."]
  ADN-UC001-009["Резидент должен иметь возможность забронировать одно свободное помещение на время начала и окончания, указав число участников и цель, в пределах часов работы локации."]
  ADN-UC001-010["Система должна отклонять бронирование помещения, если число участников превышает его вместимость."]
  ADN-UC001-011["Система должна предотвращать пересечение активных бронирований одного и того же стола или помещения."]
  ADN-UC001-012["Система должна проверять бронирование с учётом оставшихся часов тарифа резидента, разрешённых типов ресурсов и локаций и глубины предварительной записи."]
  ADN-UC001-013["Если подходящее бронирование превышает включённые в тариф часы, система должна создать настроенное начисление за дополнительное использование до его подтверждения."]
  ADN-UC001-014["Система должна создавать и поддерживать регулярные подписки на абонементы в Stripe для тарифов с онлайн-оплатой."]
  ADN-UC001-015["Система должна обновлять статусы абонементов и оплаты счетов на основании проверенных webhook-событий Stripe."]
  ADN-UC001-016["Резидент должен иметь возможность просматривать и скачивать счета и квитанции об оплате в личном кабинете."]
  ADN-UC001-017["Резидент должен иметь возможность заменить способ оплаты Stripe для будущих начислений по абонементу."]
  ADN-UC001-018["Резидент должен иметь возможность отменить будущее бронирование, если срок бесплатной отмены по тарифу ещё не истёк."]
  ADN-UC001-019["Управляющий локацией должен иметь возможность отменить любое бронирование с указанием причины и уведомить затронутого резидента."]
  ADN-UC001-020["Система должна сформировать непредсказуемый QR-код для каждого активного резидента для регистрации входа."]
  ADN-UC001-021["Сотрудник ресепшена должен иметь возможность вручную зарегистрировать вход или выход резидента после поиска по имени, адресу электронной почты или номеру абонемента."]
  ADN-UC001-022["Система должна отметить неиспользованное бронирование как неявку после окончания установленного для ресурса льготного периода, если вход не был зарегистрирован."]
  ADN-UC001-023["На дашборде ресепшена должны отображаться присутствующие резиденты, ожидаемые прибытия, активные посетители и текущая заполняемость по локации."]
  ADN-UC001-024["Резидент должен иметь возможность предварительно зарегистрировать посетителя с именем, адресом электронной почты, датой визита, принимающим резидентом и локацией."]
  ADN-UC001-025["Система должна выпустить непредсказуемый QR-пропуск посетителя на указанную дату и отправить его на электронную почту."]
  ADN-UC001-026["Сотрудник ресепшена должен иметь возможность зарегистрировать прибытие и уход посетителя, отсканировав пропуск или найдя его в списке."]
  ADN-UC001-027["Сотрудник ресепшена должен иметь возможность зарегистрировать входящую посылку с резидентом-получателем, перевозчиком, номером отслеживания и местом хранения."]
  ADN-UC001-028["Система должна отправить получателю электронное письмо при регистрации посылки."]
  ADN-UC001-029["Сотрудник ресепшена должен иметь возможность зафиксировать получателя и время выдачи посылки."]
  ADN-UC001-030["Резидент должен иметь возможность создать обращение с локацией, категорией, описанием и необязательными вложениями."]
  ADN-UC001-031["Управляющий локацией должен иметь возможность установить приоритет обращения и назначить его сотруднику."]
  ADN-UC001-032["Назначенный сотрудник должен иметь возможность последовательно менять статус обращения на «открыто», «в работе», «решено» и «закрыто»."]
  ADN-UC001-033["Резиденты и назначенные сотрудники должны иметь возможность обмениваться датированными комментариями и вложениями внутри обращения."]
  ADN-UC001-034["Управляющий локацией должен иметь возможность заблокировать стол или помещение на техническое обслуживание на указанный временной интервал с причиной."]
  ADN-UC001-035["Управляющий локацией должен иметь возможность создать повторяющийся период технического обслуживания с ежедневной, еженедельной или ежемесячной периодичностью и датой окончания."]
  ADN-UC001-036["Комьюнити-менеджер должен иметь возможность публиковать мероприятия с названием, описанием, локацией, расписанием, вместимостью, ценой и сроком окончания регистрации."]
  ADN-UC001-037["Резидент должен иметь возможность зарегистрироваться на мероприятие до окончания срока регистрации при наличии свободного места."]
  ADN-UC001-038["Если мероприятие заполнено, резидент должен иметь возможность встать в упорядоченный лист ожидания."]
  ADN-UC001-039["При отмене подтверждённой регистрации на мероприятие система должна перевести первого резидента из листа ожидания и отправить ему новый статус по электронной почте."]
  ADN-UC001-040["Комьюнити-менеджер должен иметь возможность опубликовать объявление с заголовком, содержанием, периодом публикации и необязательной ссылкой на действие."]
  ADN-UC001-041["Комьюнити-менеджер должен иметь возможность направить объявление выбранным локациям и тарифам абонементов."]
  ADN-UC001-042["Система должна отправить целевым активным резидентам электронное письмо при первой публикации объявления."]
  ADN-UC001-043["Резидент должен иметь возможность включить себя в каталог резидентов и выбрать, показывать ли имя, фотографию, компанию, должность, навыки и ссылку для связи."]
  ADN-UC001-044["Резидент должен иметь возможность просматривать историю своих бронирований, входов, посетителей, мероприятий, счетов, платежей и обращений."]
  ADN-UC001-045["В отчёте по использованию должны отображаться доступные, забронированные и фактически использованные часы, отмены, неявки и коэффициент использования по ресурсам и локациям."]
  ADN-UC001-046["В отчёте по выручке должны отображаться начисления за абонементы, дополнительное использование и мероприятия, возвраты и полученная выручка по локациям и месяцам."]
  ADN-UC001-047["Авторизованные сотрудники должны иметь возможность выгрузить текущий отфильтрованный список резидентов, бронирований, входов, посетителей, посылок, обращений, мероприятий либо отчёт по использованию или выручке в CSV."]
  ADN-UC001-048["Администратор должен иметь возможность просматривать журнал аудита изменений абонементов, оплаты, бронирований, входов, посылок, обращений, мероприятий, объявлений и прав доступа."]
  ADN-UC001-049["Резиденты должны иметь доступ только к собственным закрытым данным, а доступ сотрудников должен ограничиваться назначенными им локациями, если более широкая роль не предусматривает иное."]
  ADN-UC001-050(("end"))
