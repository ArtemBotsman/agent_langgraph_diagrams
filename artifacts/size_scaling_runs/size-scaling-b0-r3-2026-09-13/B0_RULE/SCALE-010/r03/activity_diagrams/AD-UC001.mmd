  subgraph PART-UC001-001["User"]
  ADN-UC001-001(("start"))
  ADN-UC001-002["Администраторы HR должны иметь возможность создавать и редактировать курсы с названием, описанием, целевой аудиторией, продолжительностью, предварительными требованиями и признаком необходимости согласования руководителем."]
  ADN-UC001-003["Администраторы HR должны иметь возможность запланировать учебную группу с преподавателем, временем начала и окончания, форматом проведения, местом или ссылкой на встречу, вместимостью и сроком окончания записи."]
  ADN-UC001-004["Сотрудники должны иметь возможность войти в систему с корпоративным адресом электронной почты."]
  ADN-UC001-005["Сотрудники должны иметь возможность просматривать предстоящие группы и фильтровать их по теме, формату проведения, дате и наличию свободных мест."]
  ADN-UC001-006["Сотрудник должен иметь возможность подать заявку на участие в группе до окончания срока записи."]
  ADN-UC001-007["Для курса, требующего согласования, руководитель сотрудника должен иметь возможность одобрить или отклонить заявку с необязательным комментарием."]
  ADN-UC001-008["Для курса без согласования заявка должна подтверждаться сразу при наличии свободного места."]
  ADN-UC001-009["Если группа заполнена, сотрудник, отвечающий остальным условиям, должен иметь возможность встать в упорядоченный лист ожидания."]
  ADN-UC001-010["Когда подтверждённое место освобождается, система должна перевести первого подходящего сотрудника из листа ожидания и отправить новый статус записи по электронной почте."]
  ADN-UC001-011["Сотрудник должен иметь возможность отменить подтверждённую запись до начала учебной группы."]
  ADN-UC001-012["Подтверждённый участник должен иметь возможность скачать файл iCalendar с расписанием группы."]
  ADN-UC001-013["Преподаватель должен иметь возможность просматривать список участников назначенных ему групп."]
  ADN-UC001-014["Преподаватель должен иметь возможность установить каждому записанному сотруднику статус «присутствовал», «присутствовал частично», «отсутствовал» или «отсутствовал по уважительной причине»."]
  ADN-UC001-015["Администраторы HR должны иметь возможность прикреплять к курсу доступные для скачивания учебные материалы."]
  ADN-UC001-016["Администраторы HR должны иметь возможность настроить для курса итоговый тест с выбором ответа и проходным баллом."]
  ADN-UC001-017["Записанный сотрудник должен иметь возможность отправить ответы итогового теста и сразу увидеть балл и результат прохождения."]
  ADN-UC001-018["Система должна выдавать скачиваемый сертификат при выполнении настроенных условий по посещаемости и тесту."]
  ADN-UC001-019["На дашборде HR должны отображаться показатели записи, посещаемости, завершения и прохождения по курсам и подразделениям за выбранный период."]
  ADN-UC001-020["Администраторы HR должны иметь возможность выгружать записи об обучении сотрудников в CSV."]
  ADN-UC001-021(("end"))
