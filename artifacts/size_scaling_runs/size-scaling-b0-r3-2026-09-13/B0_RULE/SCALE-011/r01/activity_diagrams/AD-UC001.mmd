  subgraph PART-UC001-001["User"]
  ADN-UC001-001(("start"))
  ADN-UC001-002["Посетитель должен иметь возможность просматривать активные товары по категориям и подкатегориям."]
  ADN-UC001-003["Посетитель должен иметь возможность искать активные товары по словам в названии, кратком описании и артикуле."]
  ADN-UC001-004["Посетитель должен иметь возможность фильтровать результаты по категории, диапазону цен, наличию и характеристикам товара, а также сортировать их по цене или новизне поступления."]
  ADN-UC001-005["На странице товара должны отображаться название, описание, изображения, цена выбранного варианта, статус наличия, характеристики и доступность доставки или самовывоза."]
  ADN-UC001-006["Покупатель должен иметь возможность выбрать активный вариант товара и количество, не превышающее текущий доступный остаток."]
  ADN-UC001-007["Покупатель должен иметь возможность добавлять варианты товаров в корзину, изменять количество, удалять позиции и видеть пересчитанную промежуточную сумму."]
  ADN-UC001-008["Покупатель должен иметь возможность перейти к оформлению заказа без создания аккаунта."]
  ADN-UC001-009["Покупатель должен иметь возможность создать аккаунт, войти в систему и использовать этот аккаунт при оформлении заказа."]
  ADN-UC001-010["Авторизованный покупатель должен иметь возможность создавать, редактировать, удалять и выбирать сохранённые адреса доставки."]
  ADN-UC001-011["Для заказа с доставкой покупатель должен иметь возможность ввести или выбрать адрес и выбрать один доступный способ доставки."]
  ADN-UC001-012["Система должна запрашивать доступные способы и стоимость доставки у Shippo на основании данных упаковки корзины и адреса доставки."]
  ADN-UC001-013["Для заказа с самовывозом покупатель должен иметь возможность выбрать активную точку выдачи с достаточным остатком по каждой позиции корзины."]
  ADN-UC001-014["Покупатель должен иметь возможность применить один активный промокод, если выполнены его условия по периоду действия, покупателю, товарам, минимальной сумме и ограничению числа использований."]
  ADN-UC001-015["Система должна рассчитывать настроенный налог с облагаемых позиций корзины с учётом выбранного адреса доставки или точки самовывоза."]
  ADN-UC001-016["Система должна создать Stripe PaymentIntent на итоговую сумму заказа и показать размещённый на стороне Stripe платёжный интерфейс."]
  ADN-UC001-017["Система должна отмечать заказ как оплаченный только после проверки успешного webhook-события Stripe по его платежу."]
  ADN-UC001-018["После оплаты система должна присвоить заказу номер и отправить покупателю электронное письмо с детализированным подтверждением."]
  ADN-UC001-019["Покупатель должен иметь возможность открыть публичную страницу отслеживания по номеру заказа и непредсказуемому токену и увидеть текущий статус исполнения."]
  ADN-UC001-020["Покупатель должен иметь возможность отменить оплаченный заказ со страницы отслеживания, пока его статус исполнения — «новый»."]
  ADN-UC001-021["Авторизованный покупатель должен иметь возможность просматривать полную историю своих заказов и открывать подробную информацию о каждом из них."]
  ADN-UC001-022["Администратор должен иметь возможность создавать, редактировать, публиковать, снимать с публикации и архивировать товары и их варианты."]
  ADN-UC001-023["Администратор должен иметь возможность корректировать доступный остаток по варианту товара и точке хранения с фиксацией количества, причины и пользователя в истории движения."]
  ADN-UC001-024["Администратор должен иметь возможность просматривать оплаченные заказы и последовательно менять их статусы на «новый», «комплектуется», «упакован», «отправлен» или «готов к выдаче» и «завершён»."]
  ADN-UC001-025["Администратор должен иметь возможность оформить полный или частичный возврат оплаченного заказа через Stripe и зафиксировать возвращённые позиции и суммы."]
  ADN-UC001-026(("end"))
