  %% activity:AD-UC001 uc:UC-001
  subgraph PART-UC001-001["User"]
  ADN-UC001-001(("start"))
  ADN-UC001-002["Пользователи должны иметь возможность войти в систему с правами аналитика, маркетолога, клиентского наблюдателя или администратора."]
  ADN-UC001-003["Администратор должен иметь возможность создавать клиентские рабочие пространства и назначать пользователей в одно или несколько пространств."]
  ADN-UC001-004["Аналитик должен иметь возможность подключить к рабочему пространству один ресурс Google Analytics 4 через Google OAuth."]
  ADN-UC001-005["Аналитик должен иметь возможность подключить к рабочему пространству один или несколько аккаунтов Google Ads через Google OAuth."]
  ADN-UC001-006["Аналитик должен иметь возможность подключить к рабочему пространству один или несколько аккаунтов Meta Ads через Meta OAuth."]
  ADN-UC001-007["Аналитик должен иметь возможность настроить ночной импорт результатов из CRM из CSV-файла по указанному пути на SFTP-сервере агентства."]
  ADN-UC001-008["Аналитик должен иметь возможность выбрать, какие подключённые ресурсы, аккаунты и столбцы CRM относятся к текущему рабочему пространству."]
  ADN-UC001-009["Система должна выполнять ночную инкрементальную синхронизацию с повторной загрузкой предыдущих 30 календарных дней для каждого активного источника."]
  ADN-UC001-010["Аналитик должен иметь возможность запустить ручную синхронизацию одного источника за выбранный диапазон дат."]
  ADN-UC001-011["На странице источника данных должен отображаться каждый запуск синхронизации с временем начала и окончания, числом импортированных строк, статусом и сводкой ошибок."]
  ADN-UC001-012["Система должна хранить нормализованные ежедневные факты по рабочему пространству, дате, источнику, средству привлечения, каналу, кампании, группе объявлений, объявлению и посадочной странице, когда соответствующие измерения доступны."]
  ADN-UC001-013["Аналитик должен иметь возможность сопоставлять комбинации исходных источника и средства привлечения с единым маркетинговым каналом."]
  ADN-UC001-014["Аналитик должен иметь возможность задавать упорядоченные правила на основе UTM-меток для сопоставления результатов CRM с едиными кампаниями."]
  ADN-UC001-015["Аналитик должен иметь возможность переопределить автоматическое сопоставление канала или кампании с сохранением предыдущего значения в истории."]
  ADN-UC001-016["Система должна рассчитывать расходы, показы, клики, сеансы, лиды, квалифицированные лиды, заказы и выручку из синхронизированных фактов."]
  ADN-UC001-017["Система должна рассчитывать кликабельность, стоимость клика, стоимость лида, стоимость привлечения клиента, конверсию и окупаемость рекламных расходов из базовых метрик."]
  ADN-UC001-018["На обзорном дашборде выбранные ключевые метрики должны отображаться карточками с текущим значением и изменением относительно сравниваемого периода."]
  ADN-UC001-019["На обзорном дашборде выбранные метрики должны отображаться как временные ряды с дневной, недельной или месячной детализацией."]
  ADN-UC001-020["На дашборде каналов должны сравниваться базовые и производные метрики по единым маркетинговым каналам."]
  ADN-UC001-021["На дашборде кампаний должна отображаться сортируемая таблица метрик кампаний с контекстом исходного аккаунта."]
  ADN-UC001-022["В представлении воронки должны отображаться сеансы, лиды, квалифицированные лиды, заказы и конверсии между этапами."]
  ADN-UC001-023["В представлении посадочных страниц должны сравниваться сеансы, лиды, заказы, выручка и конверсия по посадочным страницам."]
  ADN-UC001-024["Пользователь должен иметь возможность выбрать произвольный диапазон дат отчёта."]
  ADN-UC001-025["Пользователь должен иметь возможность сравнить выбранный диапазон с непосредственно предшествующим периодом или теми же датами предыдущего года."]
  ADN-UC001-026["Фильтры дашборда должны включать рабочее пространство, канал, источник, кампанию, категорию устройства, географию и посадочную страницу, когда соответствующие данные доступны."]
  ADN-UC001-027["Пользователь должен иметь возможность перейти от канала к его кампаниям, а от кампании — к объявлениям и посадочным страницам."]
  ADN-UC001-028["Пользователь должен иметь возможность сохранить именованное сочетание дашборда, сравнения дат, фильтров и отображаемых метрик как личное представление."]
  ADN-UC001-029["Аналитик должен иметь возможность задать целевое значение выбранной метрики для рабочего пространства и календарного месяца."]
  ADN-UC001-030["На диаграммах и в таблицах дашборда должны отображаться фактические и целевые значения метрик, для которых настроена цель."]
  ADN-UC001-031["Аналитик должен иметь возможность добавить в рабочее пространство датированную аннотацию и необязательно связать её с кампанией."]
  ADN-UC001-032["Аналитик должен иметь возможность настроить предупреждение, когда выбранная метрика отклоняется более чем на указанный процент от семидневного скользящего среднего."]
  ADN-UC001-033["Система должна отправлять настроенным получателям электронное письмо при первом обнаружении условия предупреждения и при возвращении показателя к норме."]
  ADN-UC001-034["Аналитик должен иметь возможность запланировать еженедельную или ежемесячную отправку отчёта по электронной почте для выбранных получателей, рабочего пространства, сохранённого представления и времени отправки."]
  ADN-UC001-035["Пользователь должен иметь возможность выгрузить текущее представление дашборда в PDF с фильтрами, временем формирования, карточками показателей, диаграммами и таблицами."]
  ADN-UC001-036["Пользователь должен иметь возможность выгрузить исходные строки текущей таблицы в CSV."]
  ADN-UC001-037["Аналитик должен иметь возможность создать непредсказуемую ссылку с доступом только для чтения к одному сохранённому представлению и указать срок её действия."]
  ADN-UC001-038["Аналитик должен иметь возможность немедленно отозвать активную ссылку с доступом только для чтения."]
  ADN-UC001-039["Система должна атрибутировать каждый заказ из CRM и его выручку последнему непрямому касанию кампании, зафиксированному не более чем за 30 дней до заказа."]
  ADN-UC001-040["На каждом дашборде должны отображаться время последней успешной синхронизации и самая ранняя дата с неполными данными источников."]
  ADN-UC001-041["Администратор должен иметь возможность приглашать и деактивировать пользователей и изменять их роли в рабочих пространствах."]
  ADN-UC001-042["Администратор должен иметь возможность просматривать журнал аудита изменений подключений, сопоставлений, целей, предупреждений, отчётов, публичных ссылок и прав доступа."]
  ADN-UC001-043["Клиентский наблюдатель должен иметь возможность открывать дашборды, сохранённые представления и выгрузки только тех рабочих пространств, к которым он назначен."]
  ADN-UC001-044(("end"))
