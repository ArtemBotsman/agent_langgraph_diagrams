flowchart TD
  %% activity:AD-UC001 uc:UC-001
  subgraph PART-UC001-001["User"]
  ADN-UC001-001(("start"))
  ADN-UC001-002["Пользователи должны иметь возможность войти в систему с правами диспетчера, выездного специалиста, руководителя или администратора."]
  ADN-UC001-003["Диспетчер должен иметь возможность создавать и редактировать карточки клиентов и объектов обслуживания с контактными и адресными данными."]
  ADN-UC001-004["Диспетчер должен иметь возможность зарегистрировать оборудование на объекте обслуживания с типом, производителем, моделью, серийным номером и датой установки."]
  ADN-UC001-005["Диспетчер должен иметь возможность создать заказ на работы для одного объекта обслуживания с необязательным оборудованием, категорией, описанием, приоритетом и желаемой датой завершения."]
  ADN-UC001-006["Диспетчер должен иметь возможность назначить одного специалиста на открытый заказ."]
  ADN-UC001-007["Диспетчер должен иметь возможность запланировать назначенный заказ, указав начало и окончание интервала прибытия."]
  ADN-UC001-008["Система должна обеспечивать последовательность статусов заказа «создан», «назначен», «принят», «в пути», «на объекте», «завершён» или «отменён» и фиксировать время каждого перехода."]
  ADN-UC001-009["Специалист должен иметь возможность просматривать только назначенные ему заказы, сгруппированные в списки «сегодня», «предстоящие» и «завершённые»."]
  ADN-UC001-010["Специалист должен иметь возможность принять назначенный заказ или отклонить его, указав причину."]
  ADN-UC001-011["Специалист должен иметь возможность открыть адрес объекта обслуживания в установленном на устройстве навигационном приложении."]
  ADN-UC001-012["Специалист должен иметь возможность заполнить чек-лист, связанный с категорией заказа, и указать ответ для каждого обязательного пункта."]
  ADN-UC001-013["Специалист должен иметь возможность добавлять в принятый заказ датированные заметки о работе и фотографии."]
  ADN-UC001-014["Специалист должен иметь возможность указать каждую использованную запчасть с артикулом, описанием и количеством."]
  ADN-UC001-015["Специалист должен иметь возможность получить имя и подпись клиента перед завершением заказа."]
  ADN-UC001-016["Система должна блокировать завершение, пока не заполнены все обязательные пункты чек-листа и не получена подпись клиента."]
  ADN-UC001-017["После завершения система должна сформировать PDF-отчёт об обслуживании с данными задания, ответами чек-листа, заметками, запчастями и подписью."]
  ADN-UC001-018["Система должна отправлять клиенту электронное письмо при планировании визита, переходе специалиста в статус «в пути» и готовности отчёта об обслуживании."]
  ADN-UC001-019["Доска диспетчера должна поддерживать фильтрацию заказов по дате, статусу, приоритету и назначенному специалисту."]
  ADN-UC001-020(("end"))
