LLM_PROVIDER=groq
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY_ENV=GROQ_API_KEY
GROQ_API_KEY=

# Instruct mode for reproducible structured generation.
LLM_THINKING=disabled
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_MAX_RETRY_DELAY_SECONDS=60

# Conservative local ceilings below the documented Free Plan daily token limit.
LLM_MAX_CALLS_PER_PROCESS=12
LLM_MAX_TOTAL_TOKENS_PER_PROCESS=180000
