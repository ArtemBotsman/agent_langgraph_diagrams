# Claude Opus 5 through the native Anthropic Messages API.
# Copy this file to .env.claude and fill the secret locally.
ANTHROPIC_API_KEY=

LLM_PROVIDER=anthropic
LLM_API_BASE=https://api.anthropic.com
LLM_MODEL=claude-opus-5
LLM_API_KEY_ENV=ANTHROPIC_API_KEY

# Low effort is the latency/cost pilot setting. Keep it fixed across repeats.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_MAX_RETRY_DELAY_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=12000

# Local client-side guards. These are not Anthropic account quotas.
LLM_MAX_CALLS_PER_PROCESS=3
LLM_MAX_TOTAL_TOKENS_PER_PROCESS=45000
LLM_MAX_ESTIMATED_COST_USD=2.00
LLM_INPUT_PRICE_USD_PER_MILLION=5.00
LLM_OUTPUT_PRICE_USD_PER_MILLION=25.00
ANTHROPIC_VERSION=2023-06-01
