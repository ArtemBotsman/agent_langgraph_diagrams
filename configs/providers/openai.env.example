LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
# Fixed GPT-5.5 snapshot used by the reproducible comparison protocol.
LLM_MODEL=gpt-5.5-2026-04-23
LLM_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

# The current project adapter calls the OpenAI-compatible Chat Completions API.
LLM_THINKING=disabled
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_MAX_RETRY_DELAY_SECONDS=60

# Keep small limits for the first compatibility test. Add current model prices
# only after selecting the exact model ID from the account.
LLM_MAX_CALLS_PER_PROCESS=3
LLM_MAX_TOTAL_TOKENS_PER_PROCESS=30000
LLM_MAX_ESTIMATED_COST_USD=
LLM_INPUT_PRICE_USD_PER_MILLION=5.00
LLM_OUTPUT_PRICE_USD_PER_MILLION=30.00
