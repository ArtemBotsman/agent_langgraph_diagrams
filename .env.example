# DeepSeek OpenAI-compatible configuration. Copy to .env and fill the secret locally.
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# Reproducibility and local safety limits. These are client-side limits, not provider quotas.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_MAX_RETRY_DELAY_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_CALLS_PER_PROCESS=100
LLM_MAX_TOTAL_TOKENS_PER_PROCESS=500000
# Optional soft stop. Requires both current token prices below.
LLM_MAX_ESTIMATED_COST_USD=
# DeepSeek uses LLM_THINKING. Groq uses LLM_REASONING_EFFORT instead.
LLM_THINKING=disabled
LLM_REASONING_EFFORT=
LLM_CALL_LOG_PATH=artifacts/runs/live_calls.jsonl

# Conservative peak cache-miss prices checked 2026-09-11.
LLM_INPUT_PRICE_USD_PER_MILLION=0.30
LLM_OUTPUT_PRICE_USD_PER_MILLION=1.20
